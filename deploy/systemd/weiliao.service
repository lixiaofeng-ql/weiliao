[Unit]
Description=Weiliao Chat Server (Node.js)
Documentation=https://github.com/lixiaofeng-ql/weiliao
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/weiliao/server

# 环境变量（含管理员密码）统一放在独立文件，避免 Environment= 的转义问题
# 由 deploy.sh 生成，权限 600
EnvironmentFile=/etc/weiliao.env

ExecStart=/usr/bin/node src/index.js

Restart=always
RestartSec=5
StandardOutput=append:/var/log/weiliao/server.log
StandardError=append:/var/log/weiliao/error.log

# 优雅停机（给 15 秒把数据刷盘）
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
